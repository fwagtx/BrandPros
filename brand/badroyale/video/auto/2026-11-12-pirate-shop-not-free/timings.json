 "phrases": [
  {
   "text": "Pirate Shop Access makes the Item Shop free. But not everything! Watch out for these.",
   "t0": 0.2,
   "t1": 4.305
  },
  {
   "text": "Battle Pass levels? Not included.",
   "t0": 4.605,
   "t1": 6.025
  },
  {
   "text": "Bundles that cost real money instead of V-Bucks? Not included.",
   "t0": 6.225,
   "t1": 9.865
  },
  {
   "text": "Gifting is off. And you can claim only one free Sidekick.",
   "t0": 10.115,
   "t1": 11.935
  },
  {
   "text": "Everything else, skins, emotes, gliders, cars, jam tracks, is free to claim.",
   "t0": 12.235,
   "t1": 16.175
  },
  {
   "text": "Still the best thing in Fortnite right now, right?",
   "t0": 16.475,
   "t1": 18.52
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 18.82,
   "t1": 21.805
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 22.1,
   "t1": 24.638
  }
 ],
