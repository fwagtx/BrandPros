 "phrases": [
  {
   "text": "You found Pirate Shop Access? Don't waste it. Here's exactly what to do.",
   "t0": 0.2,
   "t1": 3.87
  },
  {
   "text": "Open the Item Shop and look for the Plunder the Item Shop option.",
   "t0": 4.17,
   "t1": 7.235
  },
  {
   "text": "Hit Activate Now, and your 14 days start right there.",
   "t0": 7.535,
   "t1": 10.06
  },
  {
   "text": "You actually get two: one for this year, and one you can save for 2027.",
   "t0": 10.36,
   "t1": 14.348
  },
  {
   "text": "And you have to claim each item yourself. Nothing lands automatically!",
   "t0": 14.598,
   "t1": 17.918
  },
  {
   "text": "Which skin would you claim first?",
   "t0": 18.218,
   "t1": 19.873
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 20.123,
   "t1": 23.073
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 23.373,
   "t1": 25.828
  }
 ],
