 "phrases": [
  {
   "text": "Treasure Hunters ends December 5. That's 24 days left to find Pirate Shop Access!",
   "t0": 0.2,
   "t1": 5.0
  },
  {
   "text": "Every chest you open is a ticket: one in one hundred thirty seven thousand five hundred.",
   "t0": 5.3,
   "t1": 9.225
  },
  {
   "text": "Find it, and the Item Shop is free for 14 days. You keep everything.",
   "t0": 9.525,
   "t1": 13.255
  },
  {
   "text": "And Treasure Hours boost the odds every Saturday.",
   "t0": 13.555,
   "t1": 15.865
  },
  {
   "text": "How many chests will you open before it's gone?",
   "t0": 16.165,
   "t1": 18.61
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 18.86,
   "t1": 21.725
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 22.01,
   "t1": 24.596
  }
 ],
