 "phrases": [
  {
   "text": "Stop hunting Pirate Shop Access solo. Here's why!",
   "t0": 0.2,
   "t1": 2.09
  },
  {
   "text": "If anyone in your squad finds it in a chest, every member of the squad gets it.",
   "t0": 2.395,
   "t1": 6.2
  },
  {
   "text": "No friends online? Hit Fill. Four players means four times the chests.",
   "t0": 6.5,
   "t1": 10.05
  },
  {
   "text": "And every chest counts: normal, rare, Sprite, buried, Wanted Poster, even Relic chests.",
   "t0": 10.305,
   "t1": 14.705
  },
  {
   "text": "Who are you teaming up with tonight?",
   "t0": 15.055,
   "t1": 16.268
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 16.518,
   "t1": 19.503
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 19.803,
   "t1": 22.265
  }
 ],
