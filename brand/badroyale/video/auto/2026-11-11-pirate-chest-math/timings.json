 "phrases": [
  {
   "text": "At one in one hundred thirty seven thousand five hundred, how many chests does it take? Let's do the math.",
   "t0": 0.2,
   "t1": 4.45
  },
  {
   "text": "For a fifty percent chance, about ninety five thousand chests.",
   "t0": 4.8,
   "t1": 7.49
  },
  {
   "text": "In a squad of four, every member's chest counts for you. Four times faster.",
   "t0": 7.79,
   "t1": 11.475
  },
  {
   "text": "During a Treasure Hour, the odds go up by half.",
   "t0": 11.775,
   "t1": 13.805
  },
  {
   "text": "How many chests do you open per match?",
   "t0": 14.105,
   "t1": 15.725
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 15.975,
   "t1": 18.96
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 19.26,
   "t1": 21.722
  }
 ],
