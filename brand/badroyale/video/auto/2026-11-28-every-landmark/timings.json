 "duration": 28.366,
 "phrases": [
  {
   "text": "There are only five landmarks on the Fortnite map. Here's every single one.",
   "t0": 0.2,
   "t1": 3.515
  },
  {
   "text": "First, The Salty Skull, in the east, closest to Cursed Cavern.",
   "t0": 3.815,
   "t1": 6.54
  },
  {
   "text": "Then Baratie, in the south-east, closest to Busy Bay.",
   "t0": 6.89,
   "t1": 9.26
  },
  {
   "text": "Next, Henry, in the south-east, closest to Plunder Port.",
   "t0": 9.59,
   "t1": 12.06
  },
  {
   "text": "After that, Giant's Battlefield, near the center, closest to Loguetown.",
   "t0": 12.41,
   "t1": 15.5
  },
  {
   "text": "And last, Nami's Tangerine Grove, in the south-west, closest to Windmill Village.",
   "t0": 15.8,
   "t1": 19.76
  },
  {
   "text": "Which one have you found? Tell me in the comments!",
   "t0": 20.11,
   "t1": 22.145
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 22.395,
   "t1": 25.315
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 25.615,
   "t1": 28.067
  }
 ],
