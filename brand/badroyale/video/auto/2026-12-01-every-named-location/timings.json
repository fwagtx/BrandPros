 "phrases": [
  {
   "text": "There are eleven named locations on the Fortnite map. Here's every single one, in under a minute.",
   "t0": 0.2,
   "t1": 4.625
  },
  {
   "text": "Starting with Buggy's Beachhead, in the north.",
   "t0": 4.875,
   "t1": 6.55
  },
  {
   "text": "Cursed Cavern, in the east.",
   "t0": 6.75,
   "t1": 7.93
  },
  {
   "text": "The $.$. Rocky, in the east.",
   "t0": 8.08,
   "t1": 9.455
  },
  {
   "text": "Busy Bay, in the south-east.",
   "t0": 9.655,
   "t1": 10.885
  },
  {
   "text": "Plunder Port, in the south.",
   "t0": 11.085,
   "t1": 12.17
  },
  {
   "text": "Loguetown, in the south.",
   "t0": 12.37,
   "t1": 13.415
  },
  {
   "text": "Windmill Village, in the south-west.",
   "t0": 13.615,
   "t1": 15.155
  },
  {
   "text": "Arlong Park, in the west.",
   "t0": 15.355,
   "t1": 16.565
  },
  {
   "text": "Lantern Landing, near the center.",
   "t0": 16.715,
   "t1": 18.24
  },
  {
   "text": "The Chest, in the north-west.",
   "t0": 18.44,
   "t1": 19.625
  },
  {
   "text": "And last, Rubber Resort, in the north.",
   "t0": 19.775,
   "t1": 21.49
  },
  {
   "text": "Which one is your favorite drop? Tell me in the comments!",
   "t0": 21.69,
   "t1": 23.91
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 24.16,
   "t1": 27.025
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 27.325,
   "t1": 29.68
  }
 ],
