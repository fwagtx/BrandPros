  {
   "text": "Treasure Hours are today, and Pirate Shop Access odds are boosted. Here's the schedule!",
   "t0": 0.2,
   "t1": 4.48
  },
  {
   "text": "Round one: two to four PM Eastern. That's one to three Central.",
   "t0": 4.78,
   "t1": 8.105
  },
  {
   "text": "Round two: nine to eleven PM Eastern. Eight to ten Central.",
   "t0": 8.405,
   "t1": 11.825
  },
  {
   "text": "Both rounds: one point five times the normal odds for Pirate Shop Access.",
   "t0": 12.125,
   "t1": 15.863
  },
  {
   "text": "Squad up and open every chest. Are you playing both rounds?",
   "t0": 16.163,
   "t1": 19.633
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 19.883,
   "t1": 22.728
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 22.978,
   "t1": 25.432
  }
