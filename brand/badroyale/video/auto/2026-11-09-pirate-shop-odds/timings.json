 "phrases": [
  {
   "text": "Epic just revealed the real odds of finding Pirate Shop Access. Ready?",
   "t0": 0.2,
   "t1": 3.31
  },
  {
   "text": "One in one hundred thirty seven thousand, five hundred. Per chest, in a normal match.",
   "t0": 3.66,
   "t1": 7.605
  },
  {
   "text": "The weekly gold outfit is even rarer: one in over one and a half million.",
   "t0": 7.935,
   "t1": 11.29
  },
  {
   "text": "A gizmo? One in one hundred twenty seven. That's the common one.",
   "t0": 11.54,
   "t1": 14.47
  },
  {
   "text": "How many chests have you opened this season?",
   "t0": 14.77,
   "t1": 16.469
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 16.719,
   "t1": 19.704
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 20.004,
   "t1": 22.465
  }
 ],
