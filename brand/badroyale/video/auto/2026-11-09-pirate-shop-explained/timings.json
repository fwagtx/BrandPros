 "phrases": [
  {
   "text": "Fortnite is giving away the entire Item Shop for free. Here's how it works!",
   "t0": 0.2,
   "t1": 3.955
  },
  {
   "text": "This season, every chest you open has a tiny chance to drop Pirate Shop Access.",
   "t0": 4.305,
   "t1": 8.225
  },
  {
   "text": "Activate it, and for 14 days, everything that costs V-Bucks is free.",
   "t0": 8.525,
   "t1": 11.845
  },
  {
   "text": "Skins, emotes, pickaxes, gliders. And you keep them forever.",
   "t0": 12.125,
   "t1": 15.15
  },
  {
   "text": "Would you even know what to grab first?",
   "t0": 15.45,
   "t1": 16.929
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 17.179,
   "t1": 20.164
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 20.464,
   "t1": 22.925
  }
 ],
