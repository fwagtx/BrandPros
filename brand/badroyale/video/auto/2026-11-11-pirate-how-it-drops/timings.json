 "phrases": [
  {
   "text": "Pirate Shop Access doesn't come out of the chest like a weapon. Here's what actually happens.",
   "t0": 0.2,
   "t1": 4.335
  },
  {
   "text": "When you open a chest, there's a small chance of a treasure prize.",
   "t0": 4.685,
   "t1": 7.295
  },
  {
   "text": "It doesn't hit the floor. You get a message on screen telling you what you got.",
   "t0": 7.595,
   "t1": 10.9
  },
  {
   "text": "So don't dig through the loot. Just keep opening chests!",
   "t0": 11.2,
   "t1": 13.605
  },
  {
   "text": "Have you seen a treasure message yet?",
   "t0": 13.935,
   "t1": 15.213
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 15.463,
   "t1": 18.448
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 18.748,
   "t1": 21.21
  }
 ],
