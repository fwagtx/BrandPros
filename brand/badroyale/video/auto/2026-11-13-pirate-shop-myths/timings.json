 "phrases": [
  {
   "text": "Everyone has a theory about Pirate Shop Access. Here's what Epic actually says.",
   "t0": 0.2,
   "t1": 4.08
  },
  {
   "text": "The Token Compass? Not real. There is no such thing.",
   "t0": 4.43,
   "t1": 6.655
  },
  {
   "text": "Wearing a One Piece skin? Your skin has no effect on your odds.",
   "t0": 6.905,
   "t1": 9.625
  },
  {
   "text": "Lucky chests? Nope. Everyone has an equal chance. Just open chests.",
   "t0": 9.875,
   "t1": 13.245
  },
  {
   "text": "And Treasure Hours are tomorrow, with boosted odds. Get your squad ready!",
   "t0": 13.545,
   "t1": 16.801
  },
  {
   "text": "Which myth did you fall for?",
   "t0": 17.101,
   "t1": 18.611
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 18.861,
   "t1": 21.701
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 21.951,
   "t1": 24.376
  }
 ],
