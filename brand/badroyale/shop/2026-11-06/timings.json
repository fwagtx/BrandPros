 "phrases": [
  {
   "text": "This is today's Item Shop for November 6th.",
   "t0": 0.2,
   "t1": 2.37
  },
  {
   "text": "Three things before you spend a single V-Buck!",
   "t0": 2.5,
   "t1": 4.475
  },
  {
   "text": "The Adventure Time Bundle:",
   "t0": 4.695,
   "t1": 5.76
  },
  {
   "text": "3,800 V-Bucks, instead of 10,300.",
   "t0": 5.87,
   "t1": 8.875
  },
  {
   "text": "Infiltrator is in the shop.",
   "t0": 9.185,
   "t1": 10.45
  },
  {
   "text": "It's from Chapter 1, Season 1.",
   "t0": 10.56,
   "t1": 12.22
  },
  {
   "text": "And 18 skins are on their last day, nine of them Epic.",
   "t0": 12.48,
   "t1": 14.935
  },
  {
   "text": "Buying anything today?",
   "t0": 15.26,
   "t1": 16.164
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 16.224,
   "t1": 19.154
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 19.454,
   "t1": 21.916
  }
