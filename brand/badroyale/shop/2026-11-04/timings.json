 "phrases": [
  {
   "text": "This is today's Item Shop for November 4th.",
   "t0": 0.2,
   "t1": 2.27
  },
  {
   "text": "Three things before you spend a single V-Buck!",
   "t0": 2.4,
   "t1": 4.355
  },
  {
   "text": "The Adventure Time Bundle:",
   "t0": 4.575,
   "t1": 5.685
  },
  {
   "text": "3,800 V-Bucks, instead of 10,300.",
   "t0": 5.78,
   "t1": 8.785
  },
  {
   "text": "Steelsight is in the shop.",
   "t0": 9.095,
   "t1": 10.265
  },
  {
   "text": "It's from Chapter 1, Season 3.",
   "t0": 10.375,
   "t1": 11.905
  },
  {
   "text": "And 21 skins are on their last day, 18 of them Epic.",
   "t0": 12.175,
   "t1": 14.945
  },
  {
   "text": "Buying anything today?",
   "t0": 15.275,
   "t1": 16.156
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 16.216,
   "t1": 19.146
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 19.446,
   "t1": 21.908
