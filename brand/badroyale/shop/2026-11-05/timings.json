 "phrases": [
  {
   "text": "This is today's Item Shop for November 5th.",
   "t0": 0.2,
   "t1": 2.18
  },
  {
   "text": "Three things before you spend a single V-Buck!",
   "t0": 2.31,
   "t1": 4.265
  },
  {
   "text": "The Adventure Time Bundle:",
   "t0": 4.485,
   "t1": 5.515
  },
  {
   "text": "3,800 V-Bucks, instead of 10,300.",
   "t0": 5.615,
   "t1": 8.575
  },
  {
   "text": "Fishstick and Skully are in the shop.",
   "t0": 8.885,
   "t1": 10.33
  },
  {
   "text": "Both from Chapter 1, Season 7.",
   "t0": 10.44,
   "t1": 12.205
  },
  {
   "text": "And twelve skins are on their last day, seven of them Rare.",
   "t0": 12.485,
   "t1": 14.96
  },
  {
   "text": "Buying anything today?",
   "t0": 15.26,
   "t1": 16.147
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 16.207,
   "t1": 19.137
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 19.437,
   "t1": 21.899
