   "text": "This is today's Item Shop for November 8th.",
   "t0": 0.2,
   "t1": 2.115
  },
  {
   "text": "Three things before you spend a single V-Buck!",
   "t0": 2.245,
   "t1": 4.175
  },
  {
   "text": "The A$AP Rocky Bundle:",
   "t0": 4.395,
   "t1": 5.57
