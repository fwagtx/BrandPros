 "phrases": [
  {
   "text": "This is today's Item Shop for November 2nd.",
   "t0": 0.2,
   "t1": 2.34
  },
  {
   "text": "Three things before you spend a single V-Buck!",
   "t0": 2.47,
   "t1": 4.45
  },
  {
   "text": "The Adventure Time Bundle:",
   "t0": 4.67,
   "t1": 5.73
  },
  {
   "text": "3,800 V-Bucks, instead of 10,300.",
   "t0": 5.84,
   "t1": 8.82
  },
  {
   "text": "Commando and Shadow Ops are in the shop.",
   "t0": 9.13,
   "t1": 10.965
  },
  {
   "text": "Both from Chapter 1, Season 1.",
   "t0": 11.075,
   "t1": 12.835
  },
  {
   "text": "And 15 skins are on their last day, seven of them Epic.",
   "t0": 13.1,
   "t1": 15.779
  },
  {
   "text": "Buying anything today?",
   "t0": 16.08,
   "t1": 17.32
  },
  {
   "text": "Use code BAD in the Item Shop. It really helps the channel.",
   "t0": 17.38,
   "t1": 20.16
  },
  {
   "text": "Thank you for watching! Follow for more daily content.",
   "t0": 20.46,
   "t1": 22.942
  }
